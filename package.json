{
  "name": "estimaite-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "predev": "node scripts/ensure-local.mjs",
    "build": "next build --turbopack",
    "prebuild": "node scripts/ensure-local.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
