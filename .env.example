DATABASE_URL="file:./dev.db"
AUTH_SECRET="demo-estimaite-secret-change-me"
# Do not set AUTH_URL. Login must follow the host you open (localhost:3456,
# 127.0.0.1, or a forwarded preview). A leftover AUTH_URL=http://localhost:3000
# will send you to the wrong port after Continue.

# ─── GitLab Agentic Intake (feature-flagged; OFF unless set) ─────────────────────────────
# Master switch. Off = the whole feature is dark (no nav, no routes, no jobs).
FEATURE_GITLAB_INTAKE="0"
# 32-byte key for encrypting GitLab PATs at rest (AES-256-GCM). Provide 64 hex chars,
# a 32-byte base64 string, or any long secret (hashed to 32 bytes). REQUIRED to store a PAT.
INTAKE_ENCRYPTION_KEY=""
# Server-side Anthropic key used by the agent fill (Claude Opus 4.8). Never per-user, never
# exposed to the client. REQUIRED for the agent-draft step (P3+).
ANTHROPIC_API_KEY=""
