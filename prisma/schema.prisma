generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  passwordHash    String
  role            String
  teamId          String?
  team            Team?      @relation(fields: [teamId], references: [id])
  active          Boolean    @default(true)
  pendingApproval Boolean    @default(false)
  resetRequestedAt DateTime?
  createdAt       DateTime   @default(now())
  estimates       Estimate[] @relation("CreatedBy")
  auditEvents     AuditEvent[]
  orgSeats        OrgSeat[]
  roleGrants      RoleGrant[]
  gitlabConnections   GitLabConnection[]
  importRunsTriggered ImportRun[] @relation("TriggeredBy")
}

// A role a user may hold and switch into. `isPrimary` is the login/default role.
// Scope is EITHER a pod (teamId) or an org unit (orgUnitId); label is a display title
// (e.g. "Deputy Crew Tech Lead"). Only multi-role users have rows here; single-role
// users keep using User.role/teamId/seat unchanged.
model RoleGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  label     String?
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  orgUnitId String?
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id                 String       @id @default(cuid())
  name               String       @unique
  mappedLocation     String
  standardTeamSize   Int
  currency           String
  teamSprintRate     Float
  resourceSprintRate Float
  costMethod         String       @default("Team Sprint Rate")
  locationMixJson    String       @default("[]")
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  active             Boolean      @default(true)
  crewId             String?
  crew               OrgUnit?     @relation(fields: [crewId], references: [id])
  members            TeamMember[]
  users              User[]
  estimates          Estimate[]
  roleGrants         RoleGrant[]
}

model TeamMember {
  id            String @id @default(cuid())
  teamId        String
  team          Team   @relation(fields: [teamId], references: [id])
  name          String
  roleStream    String
  resourceLevel String
  location      String @default("India")
}

model Location {
  id               String  @id @default(cuid())
  name             String  @unique
  dailyRate        Float
  currency         String
  costMethod       String  @default("Daily Rate (CHF / resource-day)")
  standardTeamSize Int     @default(10)
  active           Boolean @default(true)
}

// Company > Division > Sub-Division > Stream > Crew. Pods/Teams hang under Crew.
model OrgUnit {
  id        String        @id @default(cuid())
  type      String
  name      String
  parentId  String?
  parent    OrgUnit?      @relation("OrgTree", fields: [parentId], references: [id])
  children  OrgUnit[]     @relation("OrgTree")
  currency  String        @default("CHF")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  teams     Team[]
  seats     OrgSeat[]
  budgets   CrewBudget[]
  roleGrants RoleGrant[]
  mappingOverrides CrewMappingOverride[]
}

model OrgSeat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  seatType  String
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CrewBudget {
  id        String   @id @default(cuid())
  crewId    String
  crew      OrgUnit  @relation(fields: [crewId], references: [id], onDelete: Cascade)
  year      Int
  amount    Float
  currency  String   @default("CHF")
  // Approval lifecycle (governed): a new budget starts PENDING and does NOT count in roll-ups until
  // APPROVED. Editing an APPROVED budget parks the proposal in pendingAmount (the approved `amount`
  // stays effective) until an approver promotes it. Existing rows default APPROVED (no behaviour change).
  status        String   @default("APPROVED")
  pendingAmount Float?
  requestedById String?
  requestedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([crewId, year])
}

// DEC-011: opt-in, governed per-crew override for a bounded set of mapping tables
// (ISSUE / EPIC / COMPLEXITY). One row per crew per table; global is the default when no
// APPROVED row exists (golden-safe). payload holds the crew's mapping rows as JSON.
model CrewMappingOverride {
  id          String    @id @default(cuid())
  crewId      String
  crew        OrgUnit   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  table       String
  status      String    @default("REQUESTED")
  payload     String
  version     Int       @default(1)
  requestedBy String?
  approvedBy  String?
  reason      String    @default("")
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([crewId, table])
}

model ConfigurationVersion {
  id        String   @id
  payload   String
  createdAt DateTime @default(now())
  active    Boolean  @default(false)
}

model Estimate {
  id                     String    @id @default(cuid())
  workItemType           String
  reference              String
  title                  String
  description            String    @default("")
  teamId                 String
  team                   Team      @relation(fields: [teamId], references: [id])
  status                 String    @default("DRAFT")
  // DEC-008 L2 (D2/D5): governed whole-CR descoping flag. Set by an explicit action, never
  // inferred; excludes the CR from Days/Point calibration. Boolean for now — architected so a
  // future scope-delta model (partial vs full, magnitude) can be added without rework.
  descoped               Boolean   @default(false)
  requester              String
  jiraId                 String?
  project                String?
  programme              String?
  release                String?
  targetDeliveryDate     DateTime?
  stance                 String    @default("NEUTRAL")
  planningMode           String    @default("RESOURCE_CONSTRAINED")
  costingModel           String    @default("RESOURCE_SPRINT")
  currency               String    @default("CHF")
  devResourceLevel       String    @default("intermediate")
  qaResourceLevel        String    @default("experienced")
  devAiProductivity      Float     @default(0)
  qaAiProductivity       Float     @default(0)
  availableDev           Int       @default(1)
  availableQa            Int       @default(1)
  targetSprints          Int       @default(1)
  otherFixedCost         Float     @default(0)
  overrideEnabled        Boolean   @default(false)
  overrideSp             Float?
  overrideReason         String?
  overrideRequestedBy    String?
  overrideApprovedBy     String?
  overrideAt             DateTime?
  complexityScoresJson   String    @default("[]")
  readinessJson          String    @default("[]")
  locationMixJson        String    @default("[]")
  resultJson             String?
  effectiveTshirt        String    @default("")
  deliveryFlag           String    @default("")
  confidence             String    @default("")
  readinessScore         Int       @default(0)
  scenarioJson           String?
  orgPathJson            String    @default("")
  configurationVersionId String
  rateVersionId          String
  pinnedInputsJson       String    @default("")
  // GitLab agentic intake (feature-flagged). MANUAL for every existing/manual estimate.
  origin                 String    @default("MANUAL")
  externalRef            String?   @unique
  externalUrl            String?
  agentRunId             String?
  createdById            String
  createdBy              User      @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  versions               EstimateVersion[]
  approvals              Approval[]
  actuals                ActualDelivery?
  auditEvents            AuditEvent[]
  baselines              EstimateBaseline[]
  fieldProvenance        EstimateFieldProvenance[]
  importItem             ImportItem?
}

// DEC-008 L3 (D3/D5): immutable, versioned baseline. v1 committed at APPROVED; calibration
// compares actuals against the committed baseline snapshot (not live resultJson). Re-baseline (L4)
// appends a new version and supersedes the prior — every version is preserved, never overwritten.
// This is NOT EstimateVersion (a generic recompute log).
model EstimateBaseline {
  id           String    @id @default(cuid())
  estimateId   String
  estimate     Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     String    // JSON snapshot of estimation inputs + calculated outputs at commit
  committedAt  DateTime  @default(now())
  committedBy  String?
  supersededAt DateTime?
  reason       String?   // null for v1 (approval); mandatory for re-baseline versions (L4)

  @@unique([estimateId, version])
  @@index([estimateId])
}

// DEC-008 L5 (D8): an immutable record of one applied per-crew calibration. Stores the exact
// contributing CR sample set so a past run can be FLAGGED "contains subsequently ineligible
// evidence" if any of those CRs is later cancelled/descoped/re-baselined — the run is never
// silently recomputed or rewritten; an authorised user may start a NEW run instead.
model CalibrationRun {
  id              String   @id @default(cuid())
  crewId          String
  configVersionId String
  appliedAt       DateTime @default(now())
  appliedBy       String?
  appliedJson     String   // [{ level, from, to }] applied at the time
  sampleJson      String   // string[] of contributing estimate ids at the time

  @@index([crewId])
}

model EstimateVersion {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  snapshot   String
  createdAt  DateTime @default(now())
}

model Approval {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  action     String
  comment    String   @default("")
  actorEmail String
  createdAt  DateTime @default(now())
}

model ActualDelivery {
  id                 String    @id @default(cuid())
  estimateId         String    @unique
  estimate           Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  actualDevPd        Float
  actualQaPd         Float
  actualSprints      Float
  actualDevResources Int
  actualQaResources  Int
  actualOtherCost    Float
  completionDate     DateTime?
  // DEC-007 A4: authoritative recency timestamp for calibration. System-set when actuals are
  // authoritatively captured (estimate → COMPLETED). NULL = not calibration-eligible. Never
  // derived from completionDate/createdAt/updatedAt; re-finalisation/immutability → DEC-008.
  finalisedAt        DateTime?
  varianceJson       String
  createdAt          DateTime  @default(now())
}

model PortfolioSettings {
  id        String   @id @default("default")
  budget    Float?
  currency  String   @default("CHF")
  updatedAt DateTime @updatedAt
}

model RbacSettings {
  id         String   @id @default("default")
  matrixJson String
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id            String    @id @default(cuid())
  estimateId    String?
  estimate      Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  action        String
  previousValue String    @default("")
  newValue      String    @default("")
  createdAt     DateTime  @default(now())
  prevHash      String    @default("")
  hash          String    @default("")

  @@index([createdAt, id])
}

// ─── GitLab Agentic Intake (feature-flagged: FEATURE_GITLAB_INTAKE) ──────────────────────────────
// Additive only; no engine/config tables touched. See docs/gitlab-agentic-intake-prd.md §9.

model GitLabConnection {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  host       String    @default("gitlab.com")
  encToken   String // AES-256-GCM encrypted PAT; never logged, never sent to client
  scopes     String    @default("read_api")
  status     String    @default("ACTIVE") // ACTIVE | REVOKED | INVALID
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, host])
}

model GitLabSourceMapping {
  id                String      @id @default(cuid())
  host              String      @default("gitlab.com")
  projectOrGroupRef String // e.g. "group/subgroup/project" or numeric project id
  crewId            String
  defaultPodTeamId  String?
  enabled           Boolean     @default(true)
  configuredById    String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  importRuns        ImportRun[]

  @@unique([host, projectOrGroupRef])
  @@index([crewId])
}

model ImportRun {
  id                    String              @id @default(cuid())
  sourceMappingId       String
  sourceMapping         GitLabSourceMapping @relation(fields: [sourceMappingId], references: [id])
  triggeredById         String
  triggeredBy           User                @relation("TriggeredBy", fields: [triggeredById], references: [id])
  crewId                String
  podTeamId             String? // set for pod-level triggers (§5.2)
  status                String              @default("QUEUED") // QUEUED | IN_PROGRESS | COMPLETED | PARTIAL | FAILED
  total                 Int                 @default(0)
  processed             Int                 @default(0)
  batchSize             Int                 @default(5)
  filtersJson           String              @default("{}")
  selectedRefsJson      String              @default("[]") // the externalRefs the user ticked
  defaultReleaseQuarter String?
  error                 String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 ImportItem[]

  @@index([crewId])
  @@index([triggeredById])
}

model ImportItem {
  id              String    @id @default(cuid())
  importRunId     String
  importRun       ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  gitlabType      String // ISSUE | EPIC
  gitlabIid       String
  externalRef     String // {projectId, iid, type} composite, stringified — idempotency key
  estimateId      String?   @unique
  estimate        Estimate? @relation(fields: [estimateId], references: [id])
  status          String    @default("PENDING") // PENDING | DRAFTED | SKIPPED | DUPLICATE | ERROR
  agentConfidence Float?
  evidenceJson    String    @default("{}")
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([importRunId])
  @@index([externalRef])
}

model EstimateFieldProvenance {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  field       String
  source      String   @default("AGENT") // AGENT | HUMAN
  confidence  Float?
  evidence    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([estimateId, field])
}
